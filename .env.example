# El Muro de los Miedos · variables de entorno
# Copia este archivo a .env y rellena con los datos de tu proyecto de Supabase.
# Supabase → Project Settings → API
#
# Ojo: estas dos son PÚBLICAS a propósito (viajan al navegador). La seguridad
# la pone RLS, no el secreto. NUNCA pongas aquí la service_role key.

PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
