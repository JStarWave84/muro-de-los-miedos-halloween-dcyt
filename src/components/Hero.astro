---
import { fechaRelativa } from "../lib/fecha";

interface Props {
  total: number;
  ultimoEn: string | null;
  errorInicial?: boolean;
}

const { total, ultimoEn, errorInicial = false } = Astro.props;

const papeles = total === 1 ? "1 papelito" : `${total} papelitos`;
const ultimo = ultimoEn ? fechaRelativa(ultimoEn) : "todavía ninguno";
---

<header class="relative mx-auto max-w-6xl px-5 pt-12 pb-6 sm:px-8 sm:pt-16">
  <p class="etiqueta flex flex-wrap items-center gap-x-3 gap-y-1">
    <span class="relative flex h-1.5 w-1.5 items-center justify-center" aria-hidden="true">
      <span class="absolute inset-0 rounded-full bg-calabaza opacity-70 motion-safe:animate-latir"></span>
      <span class="relative h-1.5 w-1.5 rounded-full bg-calabaza"></span>
    </span>
    <span>Halloween UCLADCyT</span>
    <span class="text-hueso/20">/</span>
    <span>31 de octubre</span>
    <span class="text-hueso/20">/</span>
    {errorInicial ? <span class="text-calabaza">muro con problemas</span> : <span class="text-toxico">muro abierto</span>}
  </p>

  <div class="mt-6 grid gap-10 md:grid-cols-[minmax(0,1fr)_17rem] md:items-end md:gap-12">
    <div>
      <h1
        class="font-display text-[clamp(3.4rem,11.5vw,7.6rem)] leading-[0.88] tracking-[0.012em] text-hueso"
      >
        El Muro<br />
        <span
          class="text-calabaza"
          style="text-shadow: 0 0 46px rgba(255,107,26,0.42), 0 0 120px rgba(107,33,168,0.45);"
        >
          de los Miedos
        </span>
      </h1>

      <p class="mt-7 max-w-xl text-[1.0625rem] leading-relaxed text-hueso/75">
        Escribe eso que te da miedo y cuélgalo con los demás. Sin registro, sin
        nombres reales, sin likes. Solo un muro lleno de papelitos y una vela
        encendida para que no estés solo.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="#cuelga"
          class="group inline-flex items-center gap-3 border border-hueso/25 px-5 py-3 text-sm font-semibold tracking-wide text-hueso transition hover:border-calabaza hover:bg-calabaza hover:text-carbon"
        >
          Cuelga tu miedo
          <span class="transition group-hover:translate-y-0.5" aria-hidden="true">↓</span>
        </a>
        <a
          href="#muro"
          class="inline-flex items-center gap-2 px-2 py-3 text-sm text-hueso/60 underline decoration-hueso/20 underline-offset-4 transition hover:text-hueso hover:decoration-calabaza"
        >
          Primero quiero leer
        </a>
      </div>
    </div>

    <!-- Ficha de estado del muro: datos reales, no decoración -->
    <dl class="grid grid-cols-3 gap-3 border-y border-hueso/10 py-4 md:grid-cols-1 md:gap-0 md:border-y-0 md:border-l md:py-0 md:pl-6">
      <div class="md:py-3">
        <dt class="etiqueta">Papeles colgados</dt>
        <dd class="mt-1 font-mono text-xl text-hueso tabular-nums md:text-2xl">
          {String(total).padStart(2, "0")}
        </dd>
      </div>
      <div class="border-l border-hueso/10 pl-3 md:border-l-0 md:border-t md:border-hueso/10 md:py-3 md:pl-0">
        <dt class="etiqueta">Último miedo</dt>
        <dd class="mt-1 font-mono text-sm text-hueso/80 md:text-base">{ultimo}</dd>
      </div>
      <div class="border-l border-hueso/10 pl-3 md:border-l-0 md:border-t md:border-hueso/10 md:py-3 md:pl-0">
        <dt class="etiqueta">Estado</dt>
        <dd class="mt-1 flex items-center gap-2 font-mono text-sm text-toxico md:text-base">
          <span class="h-1.5 w-1.5 rounded-full bg-toxico" aria-hidden="true"></span>
          abierto
        </dd>
      </div>
    </dl>
    <span class="sr-only">{papeles} en el muro</span>
  </div>
</header>
